---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Engineering notes on resilient systems, AI-assisted work, and practical experiments.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const link = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
---
<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" href={`${base}favicon.svg`} />
		<title>{title} · Engineering Notes</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="wordmark" href={link()}>Engineering Notes</a>
				<nav aria-label="Primary navigation">
					<a href={link('articles/')}>Articles</a>
					<a href={link('about/')}>About</a>
				</nav>
			</header>
			<main>
				<slot />
			</main>
			<footer class="site-footer">
				<span>Notes on systems, tools, and durable ways of working.</span>
				<span>© {new Date().getFullYear()} iwatebison</span>
			</footer>
		</div>
	</body>
</html>
