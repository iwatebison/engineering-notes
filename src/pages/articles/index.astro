---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const link = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<BaseLayout title="Articles" description="Engineering Notes articles.">
	<section class="page">
		<p class="eyebrow">Archive</p>
		<h1>Articles</h1>
		<p class="lede">設計、検証、運用の記録。記事はMarkdownを追加して公開します。</p>
		<ul class="post-list">
			{posts.map((post) => <li class="post-card">
				<time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('ja-JP')}</time>
				<div>
					<h3><a href={link(`articles/${post.id}/`)}>{post.data.title}</a></h3>
					<p>{post.data.description}</p>
				</div>
			</li>)}
		</ul>
	</section>
</BaseLayout>
